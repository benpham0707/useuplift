# =============================================================================
# ENVIRONMENT VARIABLES - Uplift Backend
#
# SECURITY NOTE: Never commit actual secrets to version control.
# Copy this file to .env and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
NODE_ENV=development
# NODE_ENV=production  # Use in production

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=8789

# -----------------------------------------------------------------------------
# Clerk Authentication (REQUIRED in production)
# Get these from https://dashboard.clerk.com
# -----------------------------------------------------------------------------
CLERK_SECRET_KEY=sk_test_xxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxx
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxx

# -----------------------------------------------------------------------------
# Supabase Database (REQUIRED)
# Get these from https://supabase.com/dashboard/project/_/settings/api
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co

SUPABASE_ANON_KEY=eyJxxxx
VITE_SUPABASE_ANON_KEY=eyJxxxx

# Service role key - only for backend server
SUPABASE_SERVICE_ROLE_KEY=eyJxxxx

# -----------------------------------------------------------------------------
# Stripe Billing (REQUIRED for payment features)
# Get these from https://dashboard.stripe.com/apikeys
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxxx

# Webhook secret - REQUIRED in production for secure webhook verification
# Get this from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# Optional: Price IDs for specific products
STRIPE_SUBSCRIPTION_PRICE_ID=price_xxxx
STRIPE_ADDON_50_PRICE_ID=price_xxxx
STRIPE_ADDON_100_PRICE_ID=price_xxxx

# -----------------------------------------------------------------------------
# Anthropic AI (REQUIRED for AI features)
# Get this from https://console.anthropic.com/
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxx

# -----------------------------------------------------------------------------
# CORS Configuration (REQUIRED in production)
# Comma-separated list of allowed origins
# -----------------------------------------------------------------------------
# CORS_ALLOWED_ORIGINS=https://your-app.com,https://www.your-app.com

# -----------------------------------------------------------------------------
# Development-Only Settings
# WARNING: These should NEVER be enabled in production
# -----------------------------------------------------------------------------
# ALLOW_DEV_AUTH=true  # Only set in development for testing endpoints

# =============================================================================
# SECURITY CHECKLIST FOR PRODUCTION DEPLOYMENT
# =============================================================================
#
# [ ] NODE_ENV=production
# [ ] CLERK_SECRET_KEY is set (for JWT verification)
# [ ] STRIPE_WEBHOOK_SECRET is set (webhooks fail without it)
# [ ] CORS_ALLOWED_ORIGINS lists only your production domains
# [ ] ALLOW_DEV_AUTH is NOT set (dev routes disabled)
# [ ] All keys are production keys, not test keys
# [ ] No hardcoded fallback values in code
#
# =============================================================================
