#!/bin/bash
#
# Pre-push hook: Prevent direct pushes to main.
# All changes to main must go through pull requests.
#
# To bypass in emergencies: git push --no-verify (use with extreme caution)

PROTECTED_BRANCH="main"

while read local_ref local_sha remote_ref remote_sha; do
  if [[ "$remote_ref" == "refs/heads/$PROTECTED_BRANCH" ]]; then
    echo ""
    echo "⛔ BLOCKED: Direct push to '$PROTECTED_BRANCH' is not allowed."
    echo ""
    echo "   All changes to main must go through a pull request."
    echo ""
    echo "   Workflow:"
    echo "     1. git checkout -b feat/your-feature"
    echo "     2. git push -u origin feat/your-feature"
    echo "     3. gh pr create --base main"
    echo ""
    echo "   Emergency bypass (use with caution): git push --no-verify"
    echo ""
    exit 1
  fi
done

exit 0
