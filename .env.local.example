# =============================================================================
# LOCAL DEVELOPMENT ENVIRONMENT VARIABLES
#
# Copy this file to .env.local and fill in your DEVELOPMENT keys
# DO NOT use production keys for local development!
# =============================================================================

# -----------------------------------------------------------------------------
# Clerk Authentication (DEVELOPMENT KEYS ONLY)
# Get these from your DEVELOPMENT Clerk app at https://dashboard.clerk.com
# -----------------------------------------------------------------------------

# Frontend - Use your development publishable key (pk_test_...)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_DEV_CLERK_KEY_HERE

# Backend - Use your development secret key (sk_test_...)
CLERK_SECRET_KEY=sk_test_YOUR_DEV_CLERK_SECRET_HERE
CLERK_PUBLISHABLE_KEY=pk_test_YOUR_DEV_CLERK_KEY_HERE

# -----------------------------------------------------------------------------
# Supabase Database (can be same for dev and prod)
# Get these from https://supabase.com/dashboard/project/_/settings/api
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co

SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service role key - only for backend server
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# -----------------------------------------------------------------------------
# Anthropic AI (same for dev and prod)
# Get this from https://console.anthropic.com/
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# -----------------------------------------------------------------------------
# Stripe Billing (USE TEST KEYS FOR DEVELOPMENT)
# Get test keys from https://dashboard.stripe.com/test/apikeys
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_stripe_test_key

# Optional: Test webhook secret (if testing webhooks locally)
STRIPE_WEBHOOK_SECRET=whsec_your_test_webhook_secret

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
PORT=8789
NODE_ENV=development

# -----------------------------------------------------------------------------
# IMPORTANT REMINDERS:
# -----------------------------------------------------------------------------
# 1. Use DEVELOPMENT Clerk keys (pk_test_... and sk_test_...)
# 2. Use TEST Stripe keys (sk_test_...)
# 3. Never commit this file with real keys
# 4. Restart dev server after changing these values
# 5. Configure Clerk development app to allow localhost:5173
# =============================================================================